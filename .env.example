# Copie este arquivo para .env e preencha com as suas chaves
GEMINI_API_KEY=sua_chave_gemini
GROQ_API_KEY=sua_chave_groq

# ---- Opcional: e-mail pessoal (IMAP, senha de app) — repita com EMAIL2_, EMAIL3_...
# EMAIL1_NOME=pessoal
# EMAIL1_USUARIO=seuemail@gmail.com
# EMAIL1_SENHA=senha_de_app_de_16_letras
# EMAIL1_SERVIDOR=imap.gmail.com

# ---- Opcional: agenda pessoal (link secreto iCal) — repita com AGENDA2_...
# AGENDA1_NOME=pessoal
# AGENDA1_URL=https://calendar.google.com/calendar/ical/.../basic.ics

# ---- Opcional: casa inteligente
# HA_URL=http://IP-DO-HOME-ASSISTANT:8123
# HA_TOKEN=token_de_longa_duracao
# TUYA_API_KEY=...
# TUYA_API_SECRET=...
# TUYA_REGION=us
